  <Fragment slot="scripts">
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      document.addEventListener('DOMContentLoaded', () => {
        gsap.registerPlugin(ScrollTrigger);

        gsap.set('.ingredients_item_wr', { opacity: 0, y: '20%' });
        gsap.to('.ingredients_item_wr', {
          opacity: 1,
          y: '0%',
          duration: 0.5,
          ease: 'power2.out',
          stagger: {
            each: 0.2,
            from: 'random',
          },
          scrollTrigger: {
            trigger: '.ingredients_sec',
            start: 'bottom bottom',
          },
        });
      });
    </script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const video = document.querySelector('.cta_visual_video video');
        if (!video) return;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                video.play();
                observer.disconnect();
              }
            }
          },
          { rootMargin: '200px' }
        );
        observer.observe(video);
      });
    </script>
  </Fragment>
