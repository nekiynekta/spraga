---
import '../styles/index.css';
import '../styles/global-styles.css';
import '../styles/webflow-base.css';
import '../styles/lumos-components.css';

const {
  title = 'Spraga',
  description = 'Place website meta description here',
  lang = 'fr-FR',
} = Astro.props;
---

<html data-wf-page="6a0bef792d2f84a49113641e" lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link href="/images/favicon.jpg" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.jpg" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.jpg" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.jpg" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.jpg" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.jpg" rel="icon" type="image/png" sizes="512x512" />

    <link rel="preload" as="font" type="font/otf" href="/fonts/Seriguela-Black.otf" crossorigin />
    <link rel="preload" as="font" type="font/otf" href="/fonts/Seriguela-Bold.otf" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Inter_24pt-SemiBold.woff2" crossorigin />

    <script is:inline>
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        (n.className += t + 'js'),
          (('ontouchstart' in o) || (o.DocumentTouch && c instanceof DocumentTouch)) &&
            (n.className += t + 'touch');
      })(window, document);
    </script>
  </head>
  <body>
    <slot />
    <slot name="scripts" />
  </body>
</html>
